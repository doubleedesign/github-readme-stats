{
	"name": "github-readme-stats",
	"version": "2.0.0",
	"description": "Dynamically generate language stats and repo/gist cards for your GitHub profile README",
	"keywords": [
		"github-readme-stats",
		"readme-stats",
		"cards",
		"card-generator"
	],
	"main": "src/index.js",
	"type": "module",
	"homepage": "https://github.com/doubleedesign/github-readme-stats",
	"repository": {
		"type": "git",
		"url": "https://github.com/doubleedesign/github-readme-stats.git"
	},
	"author": {
		"name": "Leesa Ward",
		"url": "https://github.com/doubleedesign"
	},
	"contributors": [
		{
			"name": "Anurag Hazra",
			"url": "https://github.com/anuraghazra/github-readme-stats"
		}
	],
	"scripts": {
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"test:update:snapshot": "node --experimental-vm-modules node_modules/jest/bin/jest.js -u",
		"test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js",
		"lint": "npx eslint --fix",
		"server:dev": "nodemon",
		"server": "node --experimental-transform-types express.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"license": "MIT",
	"devDependencies": {
		"@babel/eslint-parser": "^7.29.7",
		"@doubleedesign/doublee-site-style": "github:doubleedesign/doublee-site-style",
		"@eslint/js": "^9.39.2",
		"@storybook/addon-a11y": "^10.5.3",
		"@storybook/web-components-vite": "^10.5.2",
		"@stylistic/eslint-plugin-js": "^2.13.0",
		"@stylistic/eslint-plugin-ts": "^2.13.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"@uppercod/css-to-object": "^1.1.1",
		"axios-mock-adapter": "^2.1.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.2",
		"eslint-plugin-storybook": "^10.5.2",
		"express": "^5.2.1",
		"globals": "^16.5.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"js-yaml": "^4.1.1",
		"lint-staged": "^16.2.7",
		"nodemon": "^3.1.14",
		"parse-diff": "^0.11.1",
		"prismjs": "^1.30.0",
		"storybook": "^10.5.2",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@happy-dom/global-registrator": "^20.11.1",
		"axios": "^1.15.2",
		"cors": "^2.8.6",
		"emoji-name-map": "^2.0.3",
		"github-username-regex": "^1.0.0",
		"graphql-tag": "^2.12.7",
		"happy-dom": "^20.10.6",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,css,md}": "prettier --write"
	},
	"engines": {
		"node": ">=22"
	}
}
